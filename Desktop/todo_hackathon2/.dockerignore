# Docker ignore file for Local Kubernetes AI Operations
# Based on common patterns for Docker and Kubernetes projects

# Python-specific ignores
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.venv.bak/
ENV/
.egg-info/
.egg/

# Git-specific
.git/
.gitignore

# IDE-specific
.vscode/
.idea/
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment files (except examples)
.env
.env.*
!.env.example
!.env.*.example

# Build artifacts
build/
dist/
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Coverage
.coverage
htmlcov/
.coverage.*
.cov

# Docker-specific
Dockerfile*
.dockerignore

# Kubernetes-specific
*.secret.yaml
secrets/
.kube/
kubeconfig*
*.key
*.crt