# Environment variables for Local Kubernetes AI Operations
# Copy this file to .env and update values as needed

# Platform selection (linux, darwin, windows)
PLATFORM=linux

# Minikube configuration
MINIKUBE_DRIVER=docker
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=4096

# Kubernetes configuration
KUBERNETES_VERSION=v1.28.0
NAMESPACE=default

# Docker configuration
DOCKER_REGISTRY=localhost:5000
DOCKER_BUILD_CONTEXT=.

# Helm configuration
HELM_CHART_PATH=./deploy/helm-charts
HELM_VALUES_FILE=values.yaml

# Verification settings
VERIFICATION_TIMEOUT=300
VERIFICATION_INTERVAL=10

# Fallback settings
FALLBACK_ENABLED=true
FALLBACK_TO_DOCKER=true

# ─── Phase 5: Application Configuration ─────────────────────

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/todo_db

# Authentication
JWT_SECRET=your-jwt-secret-key-here

# AI Services
COHERE_API_KEY=your-cohere-api-key

# Dapr Configuration
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# Kafka Configuration
KAFKA_BROKERS=kafka:29092

# WebSocket
NEXT_PUBLIC_WS_URL=ws://localhost:8003

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Service Ports
BACKEND_PORT=8000
RECURRING_SERVICE_PORT=8001
NOTIFICATION_SERVICE_PORT=8002
WEBSOCKET_SERVICE_PORT=8003
AUDIT_SERVICE_PORT=8004

# Namespace
NAMESPACE=todo-app